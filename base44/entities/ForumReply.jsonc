{
  "type": "object",
  "properties": {
    "post_id": {
      "type": "string",
      "description": "ID of parent post"
    },
    "content": {
      "type": "string",
      "description": "Reply content"
    },
    "anonymous_username": {
      "type": "string",
      "description": "Anonymous username"
    },
    "likes_count": {
      "type": "number",
      "default": 0,
      "description": "Number of likes"
    }
  },
  "required": [
    "post_id",
    "content",
    "anonymous_username"
  ],
  "name": "ForumReply",
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {},
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "moderator"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "moderator"
          }
        }
      ]
    }
  }
}